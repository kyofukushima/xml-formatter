      <ParagraphSentence>
        <Sentence Num="1" WritingMode="vertical">空気調和設備の設計一次エネルギー消費量は、次の式により算出するものとする。</Sentence>
      </ParagraphSentence>
      <Item Num="1">
        <ItemTitle>（１）</ItemTitle>
        <ItemSentence>
          <Sentence Num="1">Itemの内容</Sentence>
        </ItemSentence>
        <List>
