            <Sentence Num="1" WritingMode="vertical"><QuoteStruct><Fig src="./pict/2JH00000019886.jpg"/></QuoteStruct></Sentence>
          </ListSentence>
        </List>
        <List>
          <ListSentence>
            <Sentence Num="1" WritingMode="vertical">この式において、Ｅ<Sub>ＡＣ</Sub>、Ｅ<Sub>ＡＣ，ＡＨＵ，ｄ，ｉ</Sub>及びＤ<Sub>ＡＨＵ，ｉ</Sub>は、それぞれ次の数値を表すものとする。</Sentence>
          </ListSentence>
        </List>
        <List>
          <ListSentence>
            <Sentence Num="1" WritingMode="vertical">Ｅ<Sub>ＡＣ</Sub>：空気調和設備の設計一次エネルギー消費量（単位　１年につきメガジュール）</Sentence>
          </ListSentence>
        </List>
        <List>
          <ListSentence>
            <Sentence Num="1" WritingMode="vertical">Ｅ<Sub>ＡＣ，ＡＨＵ，ｄ，ｉ</Sub>：日付ｄにおける空気調和機等ｉの１日当たりの設計一次エネルギー消費量（単位　１日につきメガジュール）</Sentence>
          </ListSentence>
        </List>
