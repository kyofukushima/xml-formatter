<?xml version='1.0' encoding='UTF-8'?>
<Law>
  <LawBody>
    <MainProvision>
      <Paragraph Num="1">
        <ParagraphNum>２</ParagraphNum>
        <ParagraphSentence>
          <Sentence Num="1">取り組むべき事項</Sentence>
        </ParagraphSentence>
        <Item Num="1">
          <ItemTitle>（１）</ItemTitle>
          <ItemSentence>
            <Column Num="1" LineBreak="true">
              <Sentence Num="1">原材料等の使用の合理化</Sentence>
            </Column>
            <Column Num="2" LineBreak="true">
              <Sentence Num="1">可能な限り使用する原材料等の量を少なくすること。</Sentence>
            </Column>
            <Column Num="3" LineBreak="true">
              <Sentence Num="1">また、過剰な包装を抑制すること。</Sentence>
            </Column>
          </ItemSentence>
        </Item>
        <Item Num="2">
          <ItemTitle>（２）</ItemTitle>
          <ItemSentence>
            <Column Num="1" LineBreak="true">
              <Sentence Num="1">耐久性の向上</Sentence>
            </Column>
            <Column Num="2" LineBreak="true">
              <Sentence Num="1">製品全体の耐久性を高めること。</Sentence>
            </Column>
          </ItemSentence>
        </Item>
      </Paragraph>
    </MainProvision>
  </LawBody>
</Law>