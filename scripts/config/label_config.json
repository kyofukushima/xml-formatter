{
  "version": "1.0",
  "label_definitions": {
    "grade_double": {
      "id": "grade_double",
      "name": "学年ラベル（2つ記載）",
      "patterns": [
        "^〔第[1-6１-６]学年及び第[1-6１-６]学年〕$"
      ],
      "examples": [
        "〔第１学年及び第２学年〕"
      ],
      "description": "特殊処理用"
    },
    "grade_single": {
      "id": "grade_single",
      "name": "学年ラベル（1つ記載）",
      "patterns": [
        "^〔第[1-6１-６]学年〕$"
      ],
      "examples": [
        "〔第１学年〕"
      ],
      "description": "特殊処理用"
    },
    "instruction": {
      "id": "instruction",
      "name": "指導項目括弧",
      "patterns": [
        "^[〔【]指導項目[〕】]$"
      ],
      "examples": [
        "〔指導項目〕",
        "【指導項目】"
      ],
      "description": "Itemレベル（特殊処理）"
    },
    "subject_label": {
      "id": "subject_label",
      "name": "括弧科目名",
      "patterns": [
        "^[〔【［（].+[〕】］）]$"
      ],
      "examples": [
        "〔医療と社会〕",
        "【医療と社会】",
        "［善悪の判断，自律，自由と責任］",
        "（相談窓口の担当者が適切に対応することができるようにしていると認められる例）"
      ],
      "description": "Itemレベル（特殊処理）- 互換用（個別タイプに分割）"
    },
    "subject_label_square": {
      "id": "subject_label_square",
      "name": "括弧科目名（〔〕）",
      "patterns": [
        "^〔.+〕$"
      ],
      "examples": [
        "〔医療と社会〕",
        "〔人体の構造と機能〕"
      ],
      "description": "Itemレベル（特殊処理）- 〔〕で囲まれた科目名"
    },
    "subject_label_double_square": {
      "id": "subject_label_double_square",
      "name": "括弧科目名（【】）",
      "patterns": [
        "^【.+】$"
      ],
      "examples": [
        "【医療と社会】",
        "【人体の構造と機能】"
      ],
      "description": "Itemレベル（特殊処理）- 【】で囲まれた科目名"
    },
    "subject_label_corner": {
      "id": "subject_label_corner",
      "name": "括弧科目名（［］）",
      "patterns": [
        "^［.+］$"
      ],
      "examples": [
        "［善悪の判断，自律，自由と責任］"
      ],
      "description": "Itemレベル（特殊処理）- ［］で囲まれた科目名"
    },
    "subject_label_round": {
      "id": "subject_label_round",
      "name": "丸括弧見出し（（））",
      "patterns": [
        "^[（(].+[）)]$"
      ],
      "examples": [
        "（丸括弧見出し）",
        "（相談窓口の担当者が適切に対応することができるようにしていると認められる例）"
      ],
      "description": "Itemレベル（特殊処理）- （）で囲まれた見出しや説明文"
    },
    "article_boundary": {
      "id": "article_boundary",
      "name": "第○パターン",
      "patterns": [
        "^第(?:[0-9]+(?:[のノ][0-9]+)*|[０-９]+(?:[のノ][０-９]+)*|[一二三四五六七八九十百千]+(?:[のノ][一二三四五六七八九十百千]+)*)$"
      ],
      "examples": [
        "第１",
        "第２",
        "第一",
        "第二",
        "第一の二",
        "第１の２",
        "第一の一の二",
        "第十三の二の二"
      ],
      "description": "Article（分割）。「第一の二」「第一の一の二」形式の枝番付き（多段含む）も同一種別として扱う"
    },
    "double_paren_uppercase_alphabet": {
      "id": "double_paren_uppercase_alphabet",
      "name": "二重括弧大文字アルファベット",
      "patterns": [
        "^[（(]{2}[A-Z]+[）)]{2}$"
      ],
      "examples": [
        "（（A））",
        "((A))",
        "（（B））"
      ],
      "description": "二重括弧大文字アルファベット"
    },
    "double_paren_lowercase_alphabet": {
      "id": "double_paren_lowercase_alphabet",
      "name": "二重括弧小文字アルファベット",
      "patterns": [
        "^[（(]{2}[a-z]+[）)]{2}$"
      ],
      "examples": [
        "((a))",
        "((b))",
        "((c))"
      ],
      "description": "二重括弧小文字アルファベット"
    },
    "double_paren_fullwidth_uppercase_alphabet": {
      "id": "double_paren_fullwidth_uppercase_alphabet",
      "name": "二重括弧全角大文字アルファベット",
      "patterns": [
        "^[（(]{2}[Ａ-Ｚ]+[）)]{2}$"
      ],
      "examples": [
        "（（Ａ））",
        "（（Ｂ））",
        "（（Ｃ））"
      ],
      "description": "二重括弧全角大文字アルファベット"
    },
    "double_paren_fullwidth_lowercase_alphabet": {
      "id": "double_paren_fullwidth_lowercase_alphabet",
      "name": "二重括弧全角小文字アルファベット",
      "patterns": [
        "^[（(]{2}[ａ-ｚ]+[）)]{2}$"
      ],
      "examples": [
        "（（ａ））",
        "（（ｂ））",
        "（（ｃ））"
      ],
      "description": "二重括弧全角小文字アルファベット"
    },
    "double_paren_alphabet": {
      "id": "double_paren_alphabet",
      "name": "二重括弧アルファベット（互換用）",
      "patterns": [
        "^[（(]{2}[a-zａ-ｚA-ZＡ-Ｚ]+[）)]{2}$"
      ],
      "examples": [
        "（（a））",
        "((a))",
        "（（ａ））"
      ],
      "description": "特殊処理用（下位互換用）"
    },
    "double_paren_halfwidth_number": {
      "id": "double_paren_halfwidth_number",
      "name": "二重括弧半角数字",
      "patterns": [
        "^[（(]{2}[0-9]+[）)]{2}$"
      ],
      "examples": [
        "((1))",
        "((123))"
      ],
      "description": "特殊処理用"
    },
    "double_paren_fullwidth_number": {
      "id": "double_paren_fullwidth_number",
      "name": "二重括弧全角数字",
      "patterns": [
        "^[（(]{2}[０-９]+[）)]{2}$"
      ],
      "examples": [
        "（（１））",
        "（（１２３））"
      ],
      "description": "特殊処理用"
    },
    "double_paren_kanji_number": {
      "id": "double_paren_kanji_number",
      "name": "二重括弧漢数字",
      "patterns": [
        "^[（(]{2}[一二三四五六七八九十百千]+[）)]{2}$"
      ],
      "examples": [
        "（（一））",
        "（（十））",
        "（（百））"
      ],
      "description": "特殊処理用"
    },
    "double_paren_katakana": {
      "id": "double_paren_katakana",
      "name": "二重括弧カタカナ",
      "patterns": [
        "^[（(]{2}[ア-ヴ]+[）)]{2}$"
      ],
      "examples": [
        "（（ア））",
        "（（イ））",
        "((ア))",
        "((イ))"
      ],
      "description": "Subitem3/Subitem4レベル"
    },
    "paren_uppercase_alphabet": {
      "id": "paren_uppercase_alphabet",
      "name": "括弧大文字アルファベット",
