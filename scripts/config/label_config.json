      ],
      "examples": [
        "一",
        "二",
        "十",
        "百",
        "千",
        "一の二",
        "十三の四"
      ],
      "description": "漢数字（Paragraph/Itemレベル）。「十の二」形式の枝番付きも同一種別として扱う"
    },
