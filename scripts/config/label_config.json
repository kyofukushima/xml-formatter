    "halfwidth_number": {
      "id": "halfwidth_number",
      "name": "半角数字",
      "patterns": [
        "^[0-9]+(?:[のノ][0-9]+)*$"
      ],
      "examples": [
        "1",
        "2",
        "3",
        "10",
        "123",
        "1の2",
        "13の2"
      ],
      "description": "半角数字（Paragraph/Itemレベル）。「1の2」形式の枝番付きも同一種別として扱う"
    },
    "fullwidth_number": {
      "id": "fullwidth_number",
      "name": "全角数字",
